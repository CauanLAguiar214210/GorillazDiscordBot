DISCORD_TOKEN=seu_token_aqui 
MONGODB_CONNECTION_STRING=mongodb://localhost:27017
MONGODB_DATABASE_NAME=gorillazbot
OWM_API_KEY=

# Guilda de teste para registrar slash commands localmente (opcional)
# DISCORD_DEV_GUILD_ID=123456789012345678

# Build Docker (não é variável de runtime e não entra neste arquivo):
# O PAT precisa ser clássico e ter a permissão read:packages.
# PowerShell: $env:NUGET_AUTH_TOKEN = "seu_pat"
# Bash:       export NUGET_AUTH_TOKEN="seu_pat"

# Cassino (LuckyMonkey microserviço)
LUCKY_MONKEY_URL=http://localhost:8080
LUCKY_MONKEY_API_KEY=dev-key
LUCKY_MONKEY_JWT_SIGNING_KEY=dev-only-signing-key-please-rotate-before-production-0123456789ab
LUCKY_MONKEY_JWT_ISSUER=LuckyMonkey
LUCKY_MONKEY_JWT_AUDIENCE=LuckyMonkey.Clients

# Áudio (Lavalink — rode o servidor em http://localhost:2333 em dev via docker compose)
LAVALINK_REST_URI=http://localhost:2333
LAVALINK_WS_URI=ws://localhost:2333/v4/websocket
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_LOCAL_AUDIO_PATH=sounds

# Espelho usado para transformar link de som instantâneo (Myinstants) em MP3 direto
AUDIO_INSTANT_MIRROR_BASE_URL=https://myinstants.site

# Segundos que o bot espera o Lavalink confirmar que a faixa começou (TrackStarted).
# Acima disso a resposta é "o áudio não começou a tocar", em vez de silêncio na call.
AUDIO_PLAYBACK_START_TIMEOUT_SECONDS=15

# Favoritos: anexos enviados ao bot viram arquivos no volume compartilhado com o Lavalink.
# No docker compose, este caminho tem de ser o mesmo montado em /opt/Lavalink/sounds/uploads.
AUDIO_UPLOAD_PATH=/audio/uploads
AUDIO_UPLOAD_MAX_MB=25
AUDIO_UPLOAD_MAX_MINUTES=10

# YouTube anti-bot (opcional; defina no shell/.env da raiz para o Lavalink)
# YOUTUBE_POT_TOKEN=
# YOUTUBE_VISITOR_DATA=

# Dias que um upload fica no disco. Depois disso ele é apagado, mesmo que esteja
# em um favorito: a limpeza usa a idade do arquivo, não a lista de favoritos.
AUDIO_UPLOAD_RETENTION_DAYS=30
